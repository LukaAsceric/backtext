{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for backtext main and hover windows",
  "windows": ["main", "hover"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "global-shortcut:default",
    "autostart:default",
    "notification:default"
  ]
}
